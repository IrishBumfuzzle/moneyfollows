# Copy to .env (git-ignored). Never commit real keys. Keep this file current.

# --- Apps (Vite exposes only VITE_* to the browser) ---
# From `npx supabase start` locally, or the project settings in the Supabase dashboard
# (region ap-south-1, Mumbai). The anon key is public by design; RLS protects the data.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Show machine-draft languages (Telugu) in the language picker, labelled "Draft" (CLAUDE.md 7.4).
VITE_SHOW_DRAFT_LANGS=false

# --- Scripts ---
# Postgres URL that `pnpm seed` loads the demo data into. Local Supabase default shown.
SUPABASE_DB_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Postgres server the SQL tests use (`pnpm db:test:up` starts one on 54330).
SUPABASE_TEST_DB_URL=postgres://postgres:postgres@localhost:54330/postgres
