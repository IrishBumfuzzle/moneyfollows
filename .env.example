# Copy to .env (git-ignored). Never commit real keys. Keep this file current.

# --- Apps (Vite exposes only VITE_* to the browser) ---
# From `npx supabase start` locally, or the project settings in the Supabase dashboard.
# The hosted project MUST be created in region ap-south-1 (South Asia, Mumbai): student data
# stays in India (CLAUDE.md 7.5). The region is fixed at creation and cannot be set in
# supabase/config.toml. Verify: Dashboard -> Project Settings -> General shows "Region:
# South Asia (Mumbai)", or `npx supabase projects list` shows ap-south-1 for the project.
# The anon key is public by design; RLS protects the data.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# The deployed student app (no trailing slash). The dashboard's join QR code opens <this>/?code=<CLASS_CODE>.
# Locally: http://localhost:5173, or the laptop's LAN address so a phone can scan it.
VITE_STUDENT_URL=http://localhost:5173
# Show machine-draft languages (Telugu) in the language picker, labelled "Draft" (CLAUDE.md 7.4).
VITE_SHOW_DRAFT_LANGS=false

# --- Scripts ---
# Postgres URL that `pnpm seed` loads the demo data into. Local Supabase default shown.
# The demo data has a known password and class code, so `pnpm seed` refuses any host other
# than localhost / 127.0.0.1 / ::1 / the CI service unless you pass --allow-remote-demo.
# For the hosted demo class only: `pnpm seed -- --hosted-demo <invited staff email>` with this
# set to the hosted connection string (Project Settings -> Database). That mode creates no
# user or password. Put the hosted URL in your shell for that one command, not in .env.
SUPABASE_DB_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Postgres server the SQL tests use (`pnpm db:test:up` starts one on 54330). If nothing
# listens there the SQL tests skip, unless CI is set (then they fail).
SUPABASE_TEST_DB_URL=postgres://postgres:postgres@localhost:54330/postgres
# Host port for `pnpm db:test:up` when 54330 is taken or reserved (Windows Hyper-V exclusions:
# `netsh interface ipv4 show excludedportrange protocol=tcp`). Change the URL above to match.
# PAISA_TEST_DB_PORT=55432

# --- Auth email (hosted project only; local dev uses Inbucket) ---
# Read by [remotes.production.auth.email.smtp] in supabase/config.toml. Export them in the
# shell before `npx supabase config push` (README, "Hosted project"). Never commit them.
SMTP_HOST=smtp.gmail.com
SMTP_USER=
# Gmail: a 16-character app password (myaccount.google.com/apppasswords), not the account password.
SMTP_PASS=
# The sender address (for Gmail, the same as SMTP_USER).
SMTP_FROM=
# The deployed dashboard (https, no trailing slash), e.g. https://<dashboard>.vercel.app. Read by
# [remotes.production.auth] in supabase/config.toml as the site URL and redirect URL, so sign-in and
# invite emails link there instead of localhost. Must be set before `config push`.
DASHBOARD_URL=

# Hosted database password (Project Settings -> Database). `supabase link` and `db push` read it.
SUPABASE_DB_PASSWORD=

# --- Staff invite script ---
# `pnpm staff:invite -- name@ngo.org` (README, "Staff accounts") invites a facilitator and adds
# them to the staff allowlist. Export these in the shell for that one command; never commit them.
# Project URL (Project Settings -> API). Falls back to VITE_SUPABASE_URL when empty.
SUPABASE_URL=
# The service_role key (Project Settings -> API; `npx supabase status` locally). It bypasses
# row-level security: keep it out of the apps, out of git and out of any VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=
# The invite link sends the person to DASHBOARD_URL when it is set (the deployed dashboard URL).
