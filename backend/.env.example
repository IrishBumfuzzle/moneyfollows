# Copy to backend/.env (gitignored). Never commit real keys.
# Add every new variable here in the same PR that starts reading it.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Matches docker-compose.yml. Start it with `npm run db:up`.
DATABASE_URL=postgres://paisa:paisa@localhost:5432/paisa_path

# Story generation through OpenRouter. Used only by the content studio at
# authoring time, never on a student request.
OPENROUTER_API_KEY=
# Any OpenRouter model slug ("provider/model") that supports JSON-schema output.
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
