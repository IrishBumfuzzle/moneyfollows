# Copy to backend/.env (gitignored). Never commit real keys.
# Add every new variable here in the same PR that starts reading it.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Matches docker-compose.yml. Start it with `npm run db:up`. The API migrates on start.
DATABASE_URL=postgres://paisa:paisa@localhost:5432/paisa_path
# Optional: a separate server for test databases (tests create and drop their own).
# TEST_DATABASE_URL=postgres://paisa:paisa@localhost:5432/paisa_path

# Signs student device tokens and staff session tokens. At least 32 characters.
# Required in production; generate one with `openssl rand -base64 48`.
JWT_SECRET=

# Comma-separated browser origins allowed to call the API (student PWA, dashboard).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Content the API validates, builds into packs and serves. Defaults to backend/content/hyderabad.
# CONTENT_DIR=
PACK_REGION=hyderabad
PACK_VERSION=dev

# Return the staff sign-in code in the API response. Local development and demos only;
# refused when NODE_ENV=production.
OTP_DEV_ECHO=true

# Story generation through OpenRouter. Not used: the content pack was written once by a
# model at authoring time and committed. Kept for the storygen adapter only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
